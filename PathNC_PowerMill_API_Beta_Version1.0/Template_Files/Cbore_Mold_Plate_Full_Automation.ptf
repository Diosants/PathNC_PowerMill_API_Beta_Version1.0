<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<!--PMILLMETHOD 1.0 http://www.powermill.com/xml/PmillMethodSchema.xml -->
<methods xmlns="x-schema:./PMillMethodSchema.xml">
  
  
  
  <!-- Tool List used
  01- Drill_HSS Diam 26.0
  02 - TipRadiused Diam 14.0 //  Rough
  03 - Flat Mill Diam 10.0 // Finish
  04 - CH  Diam 10.0 // Deburring
                   -->
   

<!--   Pre Drill Rough    -->
  <method name="Bushes-Dia-20-25-Rough">
    <selection>
      <numeric_value name="min_diam" value="20"/>     <!-- Range Diameters -->
      <numeric_value name="max_diam" value="25"/>
    </selection>
    <drill_operation>
      <string_value name="Drill.Type" value="deep_drill"/>
      <string_value name="label" value="01-Pre-Drill-Diam-20"/>
      <string_value name="Connections.Link[0].Type" value="skim"/>
      <string_value name="Connections.Link[1].Type" value="skim"/>
      <string_value name="Drill.TopType" value="block"/>
      <string_value name="Drill.DepthType" value="thru"/>
      <string_value name="Drill.Split" value="0"/>
      <string_value name="Connections.PlungeDistance" value="1"/>
      <string_value name="Drill.IncrementalStart" value="1"/>
      <string_value name="SpindleSpeed.Value" value="250"/>
      <string_value name="FeedRate.Cutting.Value" value="25"/>
      <string_value name="Coolant.Value" value="flood"/>
      <string_value name="Drill.Retract" value="on"/>
      <string_value name="Drill.PeckDepth.Value" value="5"/>   <!-- Peck Depth -->
      <string_value name="Drill.GougeCheck" value="1"/>
      <string_value name="toolpath_name" value="Pre-Drill-Diam-20-25"/>    <!-- Toolpath Name -->
      <string_value name="Sorting" value="shortest"/>
      <string_value name="Tool" value="Drill_HSS Diam 26.0"/>    <!-- Tool -->
      <string_value name="Drill.Thickness" value="0"/>
      <string_value name="Drill.AxialThickness" value="0"/>
      <string_value name="Thickness" value="0"/>
      <string_value name="AxialThickness" value="0"/>
    </drill_operation>
	
	
	  <!--  Helice Rough Through Hole -->
	  
    <drill_operation>
      <string_value name="Drill.Type" value="helical"/>
      <string_value name="label" value="02-Rough-Diam-20-25"/>
      <string_value name="Tool" value="TipRadiused Diam 14.0"/>
      <string_value name="Drill.TopType" value="hole"/>
      <string_value name="Drill.DepthType" value="hole"/>
      <string_value name="Connections.Link[0].Type" value="skim"/>
      <string_value name="Connections.Link[1].Type" value="skim"/>
      <string_value name="Connections.PlungeDistance" value="1"/>
      <string_value name="Drill.IncrementalStart" value=".5"/>
      <string_value name="Drill.PeckDepth.Value" value=".5"/>
      <string_value name="FeedRate.Cutting.Value" value="2500"/>
      <string_value name="SpindleSpeed.Value" value="2500"/>
      <string_value name="Drill.UseCycles" value="0"/>
      <string_value name="Thickness" value=".5"/>
      <string_value name="Sorting" value="shortest"/>
      <string_value name="Drill.Split" value="0"/>
      <string_value name="Tolerance" value=".1"/>
      <string_value name="Drill.GougeCheck" value="1"/>
      <string_value name="toolpath_name" value="Rough-Helical-Drill-Diam-20-25"/>
      <string_value name="Drill.AxialThickness" value=".5"/>
      <string_value name="AxialThickness" value=".5"/>
    </drill_operation>
	
