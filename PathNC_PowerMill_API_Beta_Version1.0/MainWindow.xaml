<Window x:Class="PathNC_PowerMill_API_Beta_Version1._0.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerMill Automation Suite"
        Height="480"
        Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI"
        Background="#1E1E1E">

    <Window.Resources>

        <!-- Primary Colors -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0082C9"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#0067A1"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#2D2F33"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#26282C"/>
        <SolidColorBrush x:Key="TextLightBrush" Color="#F1F1F1"/>
        <SolidColorBrush x:Key="TextDarkBrush" Color="#CFCFCF"/>

        <!-- Modern Button Style -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0097E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0070AC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel>

        <!-- TOP BAR -->
        <Border DockPanel.Dock="Top" Height="48" Background="#0067A1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,5">
                <Button Content="About" Style="{StaticResource BaseButton}" Command="{Binding AboutCommand}" />
                <Button Content="Help" Style="{StaticResource BaseButton}" Command="{Binding HelpCommand}" />
                <Button Content="Test" Style="{StaticResource BaseButton}" Click="Testbtn_Click"/>
            </StackPanel>
        </Border>

        <!-- STATUS BAR -->
        <StatusBar DockPanel.Dock="Bottom" Background="#202124" Height="32">
            <StatusBarItem Content="{Binding StatusText}">
                <StatusBarItem.Foreground>
                    <SolidColorBrush Color="White"/>
                </StatusBarItem.Foreground>
            </StatusBarItem>

            <StatusBarItem>
                <ProgressBar Width="140" Height="12" Minimum="0" Maximum="100" Value="{Binding ProgressValue}"/>
            </StatusBarItem>

            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="v1.1" Foreground="White"/>
            </StatusBarItem>

            <Button Content="Open Calculator"
                    Command="{Binding OpenCalculatorCommand}"
                    Style="{StaticResource BaseButton}"
                    Width="160"/>
        </StatusBar>

        <!-- MAIN BODY -->
        <TabControl Margin="8">

            <!-- MAIN AUTOMATION -->
            <TabItem Header="Automation">
                <DockPanel>

                    <!-- SIDE MENU -->
                    <StackPanel Width="220" Background="{StaticResource SidebarBrush}">
                        <TextBlock Text="PathNC Customization"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="10"/>

                        <Button Content="Setup" Name="BtnSetup" Click="BtnSetup_Click" Style="{StaticResource BaseButton}"/>
                        <Button Content="WorkPlane" Name="BtnWorkplane" Click="BtnWorkplane_Click" Style="{StaticResource BaseButton}"/>
                        <Button Content="Tool Database" Name="BtnToolDatabase" Click="BtnToolDatabase_Click" Style="{StaticResource BaseButton}"/>
                        <Button Content="Boundaries / Patterns" Name="BtnBoundaries" Click="BtnBoundaries_Click" Style="{StaticResource BaseButton}"/>
                        <Button Content="Holes / 2D Features / Levels" Name="BtnFeatures" Click="BtnFeatures_Click" Style="{StaticResource BaseButton}"/>
                        <Button Content="Mold Wizard" Name="BtnMoldWizard" Click="BtnMoldWizard_Click" Style="{StaticResource BaseButton}"/>
                        <Button Content="2D Wizard" Name="Btn2DStrategies" Click="Btn2Dstrategies_Click" Style="{StaticResource BaseButton}"/>
                    </StackPanel>

                    <!-- CONTENT -->
                    <Border Background="#1E1E1E" CornerRadius="6" Margin="8">
                        <ContentControl x:Name="MainContentControl"/>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- Toolpaths -->
            <TabItem Header="Feature Machining">
                <GroupBox Header="Toolpath Actions" Margin="8">
                    <StackPanel Margin="10">
                        <ComboBox ItemsSource="{Binding ToolpathActions}" SelectedItem="{Binding SelectedToolpath}"/>
                        <Button Content="Run" Command="{Binding RunToolpathCommand}" Margin="0,10,0,0"/>
                    </StackPanel>
                </GroupBox>
            </TabItem>

            <!-- Drilling -->
            <TabItem Header="Drill / Tap / Helical">
                <GroupBox Header="Peck / Deep Drill / Helical / Tap" Margin="8">
                    <StackPanel Margin="10">
                        <ComboBox ItemsSource="{Binding DrillingActions}" SelectedItem="{Binding SelectedDrilling}"/>
                        <Button Content="Run" Command="{Binding RunDrillingCommand}" Margin="0,10,0,0"/>
                    </StackPanel>
                </GroupBox>
            </TabItem>

            <!-- Methods -->
            <TabItem Header="Drilling Methods">
                <GroupBox Header="Counterbore / Screws / Tapped / Ejectors" Margin="8">
                    <StackPanel Margin="10">
                        <ComboBox ItemsSource="{Binding DrillMethodsActions}" SelectedItem="{Binding SelectedDrillMethods}"/>
                        <Button Content="Run" Command="{Binding RunDrillMethodCommand}" Margin="0,10,0,0"/>
                    </StackPanel>
                </GroupBox>
            </TabItem>

            <!-- Roughing -->
            <TabItem Header="Rough Strategies">
                <GroupBox Header="3D Roughing Strategies" Margin="8">
                    <StackPanel Margin="10">
                        <ComboBox ItemsSource="{Binding AreaClearanceActions}" SelectedItem="{Binding SelectedAreaClearance}"/>
                        <Button Content="Run" Command="{Binding RunAreaClearanceCommand}" Margin="0,10,0,0"/>
                    </StackPanel>
                </GroupBox>
            </TabItem>

            <!-- Finishing -->
            <TabItem Header="Finishing">
                <GroupBox Header="Finishing Toolpaths" Margin="8">
                    <StackPanel Margin="10">
                        <ComboBox ItemsSource="{Binding FinishingActions}" SelectedItem="{Binding SelectedFinishing}"/>
                        <Button Content="Run" Command="{Binding RunFinishingCommand}" Margin="0,10,0,0"/>
                    </StackPanel>
                </GroupBox>
            </TabItem>

            <!-- Log -->
            <TabItem Header="Log">
                <GroupBox Header="Activity Log" Margin="8">
                    <DockPanel>
                        <Button Content="Clear" Command="{Binding ClearLogCommand}" DockPanel.Dock="Top"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox ItemsSource="{Binding LogMessages}"
                                     Background="#1E1E1E"
                                     Foreground="White"
                                     BorderBrush="Gray"
                                     BorderThickness="1"/>
                        </ScrollViewer>
                    </DockPanel>
                </GroupBox>
            </TabItem>

        </TabControl>

    </DockPanel>

</Window>
