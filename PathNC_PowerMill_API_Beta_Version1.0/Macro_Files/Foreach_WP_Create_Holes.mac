//turn off dialogs and errors to suppress errors for empty featuresets
DIALOGS MESSAGE OFF
DIALOGS ERROR OFF

foreach wp in folder ('Workplane\') {
ACTIVATE Workplane $wp.name
EDIT MODEL ALL SELECT ALL
EDIT FEATURECREATE TYPE HOLE EDIT FEATURECREATE CIRCULAR ON EDIT FEATURECREATE FILTER HOLES EDIT FEATURECREATE TOPDEFINE ABSOLUTE EDIT FEATURECREATE BOTTOMDEFINE ABSOLUTE FORM CANCEL FEATURE FORM CREATEHOLE
EDIT FEATURECREATE FILTER HOLES EDIT FEATURECREATE TOPDEFINE ABSOLUTE EDIT FEATURECREATE BOTTOMDEFINE ABSOLUTE
EDIT OPTIONS CLOSETOL "0.01"
EDIT FEATURECREATE HOLES COMPOUND OFF
EDIT FEATURECREATE HOLES FIXED ON
EDIT FEATURECREATE HOLES DIRECTION DOWN
EDIT FEATURECREATE MULTAX OFF
EDIT FEATURECREATE HOLES OPEN OFF
EDIT FEATURECREATE HOLES CAPPED INCLUDE
EDIT FEATURECREATE HOLES EDITONAPPLY NO
EDIT FEATURECREATE CREATEHOLES
FORM CANCEL CREATEHOLE
EDIT MODEL ALL DESELECT ALL
RENAME Featureset # $wp.name
}
//turn on dialogs and errors
DIALOGS MESSAGE ON
DIALOGS ERROR ON
