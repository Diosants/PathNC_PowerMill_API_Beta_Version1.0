FORM STRATEGYSELECTOR
STRATEGYSELECTOR STRATEGY "3D-Area-Clearance/Model-Area-Clearance.003.ptf" NEW

FORM CANCEL STRATEGYSELECTOR
IMPORT TEMPLATE ENTITY TOOLPATH TMPLTSELECTORGUI "C:/Users/dcard/AppData/Local/Autodesk/PowerMill/My-Strategies/Rough.ptf"
EDIT TPPAGE TOOL
ACTIVATE TOOL "CUTTER D 40"
EDIT TPPAGE SWAreaClearance
EDIT PAR 'RadialDepthOfCut.UserDefined' '1' EDIT PAR 'Stepover' "28"
EDIT ZHEIGHTS AUTOMATIC STEPDOWN "1"
EDIT TPPAGE SWLeadIn
EDIT TPPAGE SWLeadOut
EDIT TPPAGE SWFirstLastLeads
EDIT TPPAGE SWLink
EDIT PAR 'Connections.Link[0].Type' 'skim'
EDIT PAR 'Connections.Link[0].Type' 'circular_arc'
EDIT TOOLPATH "1" CALCULATE
EDIT TOOLPATH "1" RECYCLE
EDIT TPPAGE SWAreaClearance
EDIT TPPAGE SWOffsetAreaClear
EDIT TPPAGE SWStepReduction
EDIT TPPAGE SWFinishAreaClr
EDIT TPPAGE SWOffsetAreaClear
EDIT PAR 'AreaClearance.Offset.Order' 'outside_in'
EDIT TOOLPATH "1" CALCULATE
EDIT TOOLPATH "1" RECYCLE
EDIT PAR 'AreaClearance.Offset.Order' 'automatic'
EDIT TPPAGE SWLeadIn
EDIT TPPAGE SWToolAxOVec
EDIT TPPAGE SWOffsetAreaClear
EDIT PAR 'AreaClearance.Offset.RemoveCusps' '1'
EDIT TOOLPATH "1" CALCULATE
EDIT TOOLPATH "1" RECYCLE
EDIT PAR 'AreaClearance.Profile.CutDirection' 'climb'
EDIT PAR 'CutDirection' 'climb'
EDIT TOOLPATH "1" CALCULATE
EDIT TOOLPATH "1" RECYCLE
EDIT PAR 'AreaClearance.Profile.CutDirection' 'any'
EDIT PAR 'CutDirection' 'any'
EDIT PAR 'AreaClearance.Offset.Preference' 'maintain_cut_dir'
EDIT TOOLPATH "1" CALCULATE
EDIT TOOLPATH "1" RECYCLE
EDIT PAR 'Spiral' '1'
EDIT PAR 'AreaClearance.Offset.Preference' 'minimise_air_moves'
EDIT TOOLPATH "1" CALCULATE
EDIT TOOLPATH "1" RECYCLE
EDIT TPPAGE SWAreaClearance
EDIT TPPAGE SWOffsetAreaClear
EDIT TPPAGE SWStepReduction
EDIT TPPAGE SWCutterComp
EDIT TPPAGE SWLink
EDIT PAR 'Toolpath.Connections.Link.First.Constraint[0].Distance.Value' "50"
EDIT TOOLPATH "1" CALCULATE
EDIT TOOLPATH "1" RECYCLE
EDIT PAR 'Connections.Link[0].ApplyConstraints' '0'
EDIT TOOLPATH "1" CALCULATE
EDIT TOOLPATH "1" RECYCLE
EDIT PAR 'Connections.Link[0].ApplyConstraints' '1'
EDIT TPPAGE SWOrderBasic
EDIT TPPAGE SWHighSpeedAClr
EDIT TPPAGE SWOrderBasic
EDIT PAR 'Ordering' 'level'
EDIT TOOLPATH "1" CALCULATE
EDIT TOOLPATH "1" RECYCLE
EDIT PAR 'Ordering' 'pocket'
EDIT TOOLPATH "1" CALCULATE
EDIT TPPAGE SWAreaFilterAClear
EDIT TPPAGE SWAreaFlatAClear
EDIT TPPAGE SWAreaClearance
EDIT TOOLPATH "1" RECYCLE
EDIT ZHEIGHTS AUTOMATIC STEPDOWN ".5"
EDIT TOOLPATH "1" CALCULATE
EDIT TOOLPATH "1" RECYCLE
EDIT TPPAGE SWOffsetAreaClear
EDIT PAR 'AreaClearance.Profile.CutDirection' 'climb'
EDIT PAR 'CutDirection' 'climb'
EDIT TOOLPATH "1" CALCULATE
EDIT TOOLPATH "1" RECYCLE
EDIT PAR 'AreaClearance.Profile.CutDirection' 'any'
EDIT PAR 'CutDirection' 'climb'
EDIT TOOLPATH "1" CALCULATE
EDIT TOOLPATH "1" RECYCLE
EDIT TPPAGE SWStepReduction
EDIT TPPAGE SWFinishAreaClr
EDIT TPPAGE SWAreaFilterAClear
EDIT TPPAGE SWAreaFlatAClear
EDIT TPPAGE SWHighSpeedAClr
EDIT PAR 'AreaClearance.Offset.Links' 'straight'
EDIT TOOLPATH "1" CALCULATE
EDIT TOOLPATH "1" RECYCLE
EDIT TPPAGE SWOrderBasic
EDIT TPPAGE SWApproach
EDIT TPPAGE SWCutterComp
EDIT TPPAGE SWPointDistrb
EDIT TPPAGE SWToolAxOVec
EDIT TPPAGE SWToolRapidMv
EDIT TPPAGE SWOffsetAreaClear
EDIT PAR 'AreaClearance.Offset.RemoveCusps' '0'
EDIT TOOLPATH "1" CALCULATE
EDIT TOOLPATH "1" RECYCLE
EDIT TPPAGE SWAreaClearance
EDIT TPPAGE SWOffsetAreaClear
EDIT TPPAGE SWStepReduction
EDIT TPPAGE SWFinishAreaClr
EDIT TPPAGE SWCutterComp
EDIT TPPAGE SWPointDistrb
EDIT TPPAGE SWToolAxOVec
EDIT TPPAGE SWToolAxis
EDIT TPPAGE SWToolRapidMv
EDIT TPPAGE SWToolRapidMvClear
EDIT TPPAGE SWLeadsLinks
EDIT TPPAGE SWSEPtSPoint
EDIT TOOLPATH START TYPE POINT_SAFE
EDIT TOOLPATH "1" CALCULATE
EDIT TOOLPATH "1" RECYCLE
FORM CANCEL SFAreaClearance
ROTATE TRANSFORM TOP
CREATE BOUNDARY ; BLOCK FORM BOUNDARY
EDIT BOUNDARY "1" CALCULATE
EDIT BOUNDARY "1" ACCEPT BOUNDARY ACCEPT
FORM STRATEGYSELECTOR
FORM CANCEL STRATEGYSELECTOR
IMPORT TEMPLATE ENTITY TOOLPATH TMPLTSELECTORGUI "C:/Users/dcard/AppData/Local/Autodesk/PowerMill/My-Strategies/Rough.ptf"
EDIT TPPAGE SWLimit
EDIT PAR 'ZRange.Minimum.Active' 0
ACTIVATE BOUNDARY "1"
EDIT TOOLPATH "2" CALCULATE
EDIT TOOLPATH "2" RECYCLE
EDIT TPPAGE SWAreaClearance
EDIT TPPAGE TOOL
ACTIVATE TOOL "CUTTER D 40"
EDIT TOOLPATH "2" CALCULATE
EDIT TOOLPATH "2" RECYCLE
EDIT TPPAGE SWAreaClearance
EDIT PAR 'RadialDepthOfCut.UserDefined' '1' EDIT PAR 'Stepover' "28"
EDIT TOOLPATH "2" CALCULATE
EDIT TOOLPATH "2" RECYCLE
EDIT TPPAGE SWOffsetAreaClear
EDIT TPPAGE SWStepReduction
EDIT TPPAGE SWCutterComp
EDIT TPPAGE SWLeadsLinks
EDIT TPPAGE SWLeadIn
EDIT TPPAGE SWLeadOut
EDIT TPPAGE SWFirstLastLeads
EDIT TPPAGE SWLink
EDIT PAR 'Connections.Link[0].Type' 'skim'
EDIT PAR 'Connections.DefaultLink[0].Type' 'incremental'
EDIT TOOLPATH "2" CALCULATE
FORM ACCEPT SFAreaClearance
