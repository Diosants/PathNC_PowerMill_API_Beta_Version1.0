CREATE STOCKMODEL ; FORM STOCKMODEL
EDIT STOCKMODEL "#" REAPPLYFROMGUI
EXPLORER SELECT StockModel "StockModel\#" NEW
EDIT STOCKMODEL "#" BLOCK ;
EDIT STOCKMODEL "#" CALCULATE_STATE INDEXED_STATE 0
EXPLORER SELECT Toolpath "Toolpath\Model_Area_Clearance" NEW
EDIT STOCKMODEL ; INSERT_INPUT TOOLPATH "Model_Area_Clearance" LAST
EDIT STOCKMODEL "#" CALCULATE_STATE INDEXED_STATE 1
EXPLORER SELECT StockModel "StockModel\#" NEW
UNDRAW STOCKMODEL "#"
//PICK -892.173 -693.471 892.173 693.471 -71.2594 248.115 -59.9612 -0.899603 -0.18597 -0.395133 0.341347 //0.264917 -0.901832 0 -718.64 -53.6496 -718.64 -53.6496
EXPLORER SELECT Toolpath "Toolpath\Model_Area_Clearance" NEW
DRAW Toolpath "Model_Area_Clearance"
