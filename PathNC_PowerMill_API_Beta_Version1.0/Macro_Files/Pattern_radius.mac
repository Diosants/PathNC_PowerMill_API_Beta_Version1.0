REAL $VarDiameter = INPUT " Radius (mm)"
CREATE PATTERN ; EDIT PATTERN ; CURVEEDITOR NOGUI START
CURVEEDITOR MODE CIRCLE
CURVEEDITOR CIRCLE RADIUS $VarDiameter
MACRO PAUSE " PICK YOUR POINT"
CURVEEDITOR FINISH ACCEPT
EXPLORER SELECT Pattern "Pattern\#" NEW
STRING BName = "Pattern Diam " + $VarDiameter 
RENAME  Pattern ; $BName
PRINT =  Pattern.Name
