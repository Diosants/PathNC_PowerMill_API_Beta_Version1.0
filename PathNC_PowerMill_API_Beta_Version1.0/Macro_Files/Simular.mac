   
   FORM RIBBON TAB "Simulation"
   SIMULATE VIEWMILL START
   SIMULATE VIEWMILL SHADING FIXEDDIRECTION
   SIMULATE VIEWMILL SHADING RAINBOW
   REFRESH VIEWMILL RESIZEVIEW
   EDIT PAR 'Simulation.Speed' 100
   EDIT PAR 'Powermill.Simulation.Issues.PlaybackSetting' 'never'
// Simula cada percurso
FOREACH tp IN folder('toolpath') { 
  ACTIVATE TOOLPATH $tp.Name 
  SIMULATE TOOLPATH $tp.Name TOOLBAR SIMULATION RAISE
  SIMULATE PLAY
   
  }
  // no fim de todos os percursos faz
   UNDRAW TOOLPATH ALL
   DEACTIVATE TOOLPATH
   DEACTIVATE WORKPLANE
   FORM MACHINEISSUES
   SIMULATE VIEWMILL NORAPID
  EDIT PAR 'SimulationState.Issues.CheckReconfigurations' 0
FORM ACCEPT MACHINEISSUES
SIMULATE VIEWMILL STOP
    YES
    // TERMINADO
 //