RESET LOCALVARS
EDIT TOOLPATH LEADS RAISEFORM
 REAL $VarRapidClearance = INPUT "INPUT RAPID CLEARANCE"
 REAL $VarPlungeClearance = INPUT "INPUT PLUNGE CLEARANCE"
EDIT TOOLPATH CONNECTION 'Rapid.CalculateDimensions.RapidClearance'  "$VarRapidClearance"
EDIT TOOLPATH CONNECTION 'Rapid.CalculateDimensions.PlungeClearance'  "$VarPlungeClearance"
EDIT TOOLPATH SAFEAREA APPLY
EDIT TOOLPATH SAFEAREA CALCULATE_DIMENSIONS
LEADS ACCEPT