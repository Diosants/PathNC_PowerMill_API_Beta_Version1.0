

CREATE PATTERN ;
EDIT PATTERN ;
CURVEEDITOR NOGUI START
CURVEEDITOR MODE COLLECT
MACRO PAUSE "Collect your curves"
CURVEEDITOR COLLECT ACCEPT
CURVEEDITOR FINISH ACCEPT

EXPLORER SELECT Pattern "Pattern\#" NEW
STRING BName = "Pattern_type_ " + string(Pattern.Type)
RENAME  Pattern ; $BName
PRINT =  Pattern.Name
