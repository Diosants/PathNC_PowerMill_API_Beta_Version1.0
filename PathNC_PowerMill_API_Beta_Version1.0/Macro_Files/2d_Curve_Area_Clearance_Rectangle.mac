RESET LOCALVARS

//  deleting existing block first

FORM BLOCK
DELETE BLOCK
EDIT BLOCK XLEN UNLOCK
EDIT BLOCK YLEN UNLOCK
EDIT BLOCK ZLEN UNLOCK
EDIT BLOCK RESETLIMIT "0"
BLOCK ACCEPT
//


// ================================
//   CREATE PATTERN FROM USER INPUT
// ================================

RESET LOCALVARS

// --- Ask user for block dimensions ---
REAL $VarXBlock = INPUT "Enter Block Length (X dimension in mm)"
REAL $VarYBlock = INPUT "Enter Block Width (Y dimension in mm)"

// --- Calculate coordinates based on center origin ---
REAL $xMinus = -($VarXBlock / 2)
REAL $yMinus = -($VarYBlock / 2)
REAL $xPlus  =  ($VarXBlock / 2)
REAL $yPlus  =  ($VarYBlock / 2)

CREATE PATTERN ; EDIT PATTERN ; CURVEEDITOR NOGUI START
CURVEEDITOR MODE RECTANGLE
MODE COORDINPUT COORDINATES $xMinus $yMinus 0
MODE COORDINPUT COORDINATES $xPlus $yPlus 0
CURVEEDITOR FINISH ACCEPT


EXPLORER SELECT Pattern "Pattern\#" NEW


STRING $BName = "Pattern_Rectangle_X" + STRING($VarXBlock) + "_Y" + STRING($VarYBlock)
RENAME Pattern ; $BName
PRINT = Pattern.Name
ACTIVATE PATTERN $BName

// =======================================
//  BLOCK CREATION MACRO
//  Author: Diogenes Cardoso
//  Description: Create block by user choice (Box or Cylinder)
// =======================================


// --- VARIABLES ---
STRING LIST $BlockTypeOptions = {"Box", "Cylinder"}
INT $BlockTypeSelected = INPUT CHOICE $BlockTypeOptions "Select Block Type:"


// --- CHOOSE BLOCK TYPE ---
FORM BLOCK

SWITCH $BlockTypeSelected {
    CASE 0
        EDIT BLOCKTYPE BOX
        BREAK

    CASE 1
        EDIT BLOCKTYPE CYLINDER
        BREAK
}


REAL $VarBlockSpansion = INPUT " ENTER BLOCK EXPANSION"
REAL $VarBlockDepth = INPUT " ENTER BLOCK DEPTH"






// --- DEFINE BLOCK PARAMETERS ---
EDIT BLOCK COORDINATE WORKPLANE
EDIT BLOCK LIMITTYPE PATTERN
EDIT BLOCK RESET
EDIT BLOCK ZMIN LOCK
EDIT BLOCK ZMAX LOCK
EDIT BLOCK RESETLIMIT $VarBlockSpansion 
EDIT BLOCK RESET
EDIT BLOCK ZMIN UNLOCK
EDIT BLOCK ZMIN $VarBlockDepth
EDIT BLOCK ZMIN LOCK

BLOCK ACCEPT

STRING $VarSelectedTool = INPUT ENTITY TOOL "Please select a tool from the list."
REAL  $VarToolDepth = INPUT  " Enter Z Stepdown (Must be Positive)" 
REAL  $VarCurvethickness = INPUT  " Enter Stock to leave per side " 


// Define options
//STRING LIST $CutDirectionOptions = {"Conventional", "Climb", "Any"}

// Ask the user which direction to use
//INT $CutDirectionSelected = INPUT CHOICE $CutDirectionOptions "Select Cut Direction:"

// Apply user's selection to the parameter
//SWITCH $CutDirectionSelected {
  //  CASE 0
   //     EDIT PAR 'AreaClearance.Profile.CutDirection' 'conventional'
   // CASE 1
    //    EDIT PAR 'AreaClearance.Profile.CutDirection' 'climb'
  //  CASE 2
      //  EDIT PAR 'AreaClearance.Profile.CutDirection' 'any'
  //}  



STRING $VarSelectedPattern = INPUT ENTITY PATTERN "Please select  Pattern."

STRATEGYSELECTOR STRATEGY "Curve-Machining/2D-Curve-Area-Clearance.003.ptf" NEW
IMPORT TEMPLATE ENTITY TOOLPATH TMPLTSELECTORGUI "Curve-Machining/2D-Curve-Area-Clearance.003.ptf"



//RENAME TOOLPATH "#" "1"
EDIT TPPAGE TOOL
EDIT TPPAGE SWBlock
EDIT TOOLPATH ; PARENTSTOCK YES
EDIT TPPAGE TOOL
ACTIVATE TOOL $VarSelectedTool
EDIT TPPAGE SWLimit
EDIT TPPAGE SWCurveProfile
EDIT PAR 'CurveThickness' $VarCurvethickness
EDIT PAR 'ZLimits.Minimum' $VarBlockDepth  
EDIT TPPAGE SWAutoVerifMdlG
EDIT PAR 'Thickness' $VarCurvethickness
EDIT PAR 'RadialDepthOfCut.UserDefined' '1' EDIT PAR 'Stepover' "15"
EDIT PAR 'Tolerance' ".1"
EDIT PAR 'GeometryPosition' 'part'
EDIT TPPAGE SWOffsetCurveAC
EDIT PAR 'AreaClearance.Offset.RemoveCusps' '0'
EDIT PAR 'AreaClearance.Offset.Style' 'model_block_joined'
EDIT PAR 'ModelGougeCheck' '1'
EDIT PAR 'CollisionCheck' '1'
EDIT TPPAGE SWCutDistVerHor
EDIT TPPAGE SWCurveProfile
EDIT PAR 'AreaClearance.Profile.CutDirection' 'any'
EDIT PAR 'AreaClearance.Type' 'offset'
EDIT PAR 'Pattern' "$BName"
EDIT PATTERN_DECORATION EDIT_MODE
MACRO PAUSE " Select Machine Side"
EDIT PATTERN_DECORATION SHOW_MODE

EDIT TPPAGE SWCutDistVerHor
EDIT PAR 'CutDistances.Axial.Extent' 'limits'
EDIT PAR 'AxialDepthOfCut.UserDefined' '1' EDIT PAR 'Stepdown' $VarToolDepth


// Leads in/ Out
EDIT TOOLPATH LEADS LEADIN RAMP
EDIT TOOLPATH LEADS LEADOUT COPY




//  Links
EDIT TPPAGE SWLink
EDIT PAR 'Connections.Link[0].Type' 'circular_arc'
EDIT PAR 'Connections.Link.First.Constraint[0].Distance.Value' "30"
EDIT PAR 'Connections.Link[1].Type' 'skim'
EDIT PAR 'Connections.DefaultLink[0].Type' 'safe'



EDIT TOOLPATH "#" CALCULATE
FORM ACCEPT SFCurveAreaClear
STRING TName = string(Tool.Name) + " (Stock) " +  string(Toolpath.Thickness)
RENAME TOOLPATH ; $TName
PRINT = Toolpath.Name


ROTATE TRANSFORM ISO1
DELETE SCALE





