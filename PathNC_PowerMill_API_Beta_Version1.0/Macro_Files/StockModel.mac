// Macro Stock Model


CREATE STOCKMODEL ; FORM STOCKMODEL
RENAME STOCKMODEL # "STOCK"
EDIT STOCKMODEL "STOCK" TOLERANCE $VarTol
EDIT STOCKMODEL "STOCK" STEPOVER $VarStp
EDIT STOCKMODEL "STOCK" RESTTHICKNESS $VarRst
EDIT STOCKMODEL "STOCK" REAPPLYFROMGUI
EDIT STOCKMODEL "STOCK" BLOCK ;
EDIT STOCKMODEL "STOCK" CALCULATE_STATE INDEXED_STATE 0
EXPLORER SELECT StockModel "StockModel\STOCK" NEW
EDIT STOCKMODEL "STOCK" SHADING DEFAULT
DEACTIVATE STOCKMODEL
