// ==============================
// STRATEGY FUNCTION 5
// ==============================
FUNCTION RunFinishProfile(STRING $FtName, STRING $tool, REAL $step, REAL $stock)
{
    MESSAGE INFO "Running Finish Profile..."

    FORM STRATEGYSELECTOR
    STRATEGYSELECTOR STRATEGY "Feature-Machining/Feature-Profile.ptf" NEW
    IMPORT TEMPLATE ENTITY TOOLPATH TMPLTSELECTORGUI "Feature-Machining/Feature-Profile.ptf"

    ACTIVATE FEATUREGROUP $FtName
    ACTIVATE TOOL $tool
    EDIT PAR 'Thickness' $stock
    EDIT TOOLPATH "1" CALCULATE

    CALL RenameToolpath()
    MESSAGE INFO "Finish Profile calculated successfully."
}



// ==============================
// HELPER FUNCTION: RenameToolpath
// ==============================
FUNCTION RenameToolpath()
{
    STRING $tpName = Tool.Name + "_" + Toolpath.Strategy
    RENAME TOOLPATH "1" $tpName
    PRINT "Renamed toolpath: " + $tpName
}
