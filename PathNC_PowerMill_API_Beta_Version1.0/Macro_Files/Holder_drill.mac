// Chamfer

RESET LOCALVARS

FUNCTION MAIN()
{

// Ask user for tool parameters
REAL toolDia      = INPUT "Enter Tool Diameter (mm)"
REAL toolLength   = INPUT "Enter Tool Total Length (mm)"
REAL toolAngle = INPUT " Enter Drill Angle (mm)"
REAL toolOverhang = INPUT "Enter Tool Overhang (mm)"


ROTATE TRANSFORM FRONT
CREATE TOOL ; DRILL FORM TOOL
EDIT TOOL "#" DIAMETER $toolDia
EDIT TOOL "#" LENGTH $toolLength
EDIT TOOL "#" TAPERANGLE $toolAngle
TOOL ACCEPT
CREATE PATTERN ;
EXPLORER SELECT Pattern "Pattern\1" NEW
EDIT PATTERN "1" CURVEEDITOR START
CURVEEDITOR MODE LINE_MULTI
PICK -40.9609 -38.1025 40.9609 38.1025 18.6022 -7.87782 2.94429 -0 -1 -0 0 0 1 0 -18.4583 -2.94967 -18.4583 -2.94967
PICK -40.9609 -38.1025 40.9609 38.1025 18.6022 -7.87782 2.94429 -0 -1 -0 0 0 1 0 -3.49704 -2.94967 -3.49704 -2.94967
PICK -40.9609 -38.1025 40.9609 38.1025 18.6022 -7.87782 2.94429 -0 -1 -0 0 0 1 0 -0.881861 1.06432 -0.881861 1.06432
PICK -244.146 -227.108 244.146 227.108 21.5395 -7.87782 -28.6734 -0 -1 -0 0 0 1 0 -3.08128 75.582 -3.08128 75.582
PICK -77.2494 -71.8585 77.2494 71.8585 19.5585 -7.87782 22.4576 -0 -1 -0 0 0 1 0 4.98938 23.9146 4.98938 23.9146
PICK -77.2494 -71.8585 77.2494 71.8585 19.5585 -7.87782 22.4576 -0 -1 -0 0 0 1 0 5.44817 31.5994 5.44817 31.5994
PICK -77.2494 -71.8585 77.2494 71.8585 19.5585 -7.87782 22.4576 -0 -1 -0 0 0 1 0 2.12192 34.0081 2.12192 34.0081
PICK -77.2494 -71.8585 77.2494 71.8585 19.5585 -7.87782 22.4576 -0 -1 -0 0 0 1 0 2.46602 38.596 2.46602 38.596
PICK -77.2494 -71.8585 77.2494 71.8585 19.5585 -7.87782 22.4576 -0 -1 -0 0 0 1 0 4.98938 42.9545 4.98938 42.9545
PICK -63.6515 -59.2096 63.6515 59.2096 18.6624 -7.87782 38.5412 -0 -1 -0 0 0 1 0 5.81228 34.5429 5.81228 34.5429
PICK -63.6515 -59.2096 63.6515 59.2096 18.6624 -7.87782 38.5412 -0 -1 -0 0 0 1 0 -0.708814 34.4484 -0.708814 34.4484
PICK -43.2152 -40.1994 43.2152 40.1994 20.4491 -7.87782 53.4613 -0 -1 -0 0 0 1 0 -2.85535 22.4257 -2.85535 22.4257
PICK -89.5394 -83.2909 89.5394 83.2909 21.0275 -7.87782 76.9301 -0 -1 -0 0 0 1 0 -10.9681 73.187 -10.9681 73.187
PICK -89.5394 -83.2909 89.5394 83.2909 21.0275 -7.87782 76.9301 -0 -1 -0 0 0 1 0 -17.0836 73.5858 -17.0836 73.5858
CURVEEDITOR FINISH ACCEPT

EXPLORER SELECT Tool "Tool\#" NEW
FORM TOOL "#"
EDIT TOOL "#" HOLDERFROM PATTERN "1"
EDIT TOOL "#" HOLDERFROM CREATE
EDIT TOOL "#" OVERHANG $toolOverhang
TOOL ACCEPT
STRING TName = "Chamfer" + " Diam " + string(Tool.Diameter)
RENAME TOOL ; $TName
PRINT = Tool.Name
TOOL ACCEPT

EXPLORER SELECT Pattern "Pattern\1" NEW
DELETE PATTERN "1"
}
