

DIALOGS MESSAGE OFF DIALOGS ERROR OFF 
//


// NOTE: FOR USE AUTOSET WORK PLANE YOU MUST SET YOUR PIECE ACCORDING TO YOUR POSITION IN GLOBAL WORKPLANE

// MACRO ROUGH MOULD USING 03 TOOLS//
//    SHOULDER MILL DIAM 40 R1.5//
//  SHOULDER MILL DIAM 20 R1//
//   ENDMILL DIAM 10 R1//


//   AUTOSET WORKPLANE

//  DECLARING VARIABLES//

REAL $VarSafearea = INPUT " Input safe area size"
REAL $VarPlunge = INPUT " Input plunge size"

PICK -491.932 -439.286 491.932 439.286 -28.9639 170.984 31.8204 0 0 1 0 1 0 0 -212.977 -245.795 -212.977 -245.795
EDIT MODEL ALL SELECT SURFACE
MODE WORKPLANE_CREATE ; SELECTION TOP
EXPLORER SELECT Workplane "Workplane\1" NEW
ACTIVATE WORKPLANE "1"
EXPLORER SELECT Model "Model\Boss" NEW
TRANSFORM RESET TRANSFORM TYPE WORLD TRANSFORM MODEL ALL SELECTED
EXPLORER SELECT Workplane "Workplane\1" NEW
DEACTIVATE WORKPLANE
DELETE Workplane "1"
FORM BLOCK
EDIT BLOCK COORDINATE WORLD
EDIT BLOCK RESET
BLOCK ACCEPT
EDIT TOOLPATH LEADS RAISEFORM
EDIT TOOLPATH SAFEAREA SIZE  $VarSafearea
EDIT TOOLPATH SAFEAREA PLUNGE_SIZE  $VarPlunge
EDIT TOOLPATH SAFEAREA DRAWABLE RAPID ON
EDIT TOOLPATH SAFEAREA DRAWABLE PLUNGE ON
EDIT TOOLPATH LEADS PAGE LINK
EDIT PAR 'Connections.Link[0].Type' 'skim'
EDIT PAR 'Connections.Link[1].Type' 'skim'
EDIT PAR 'Connections.DefaultLink[0].Type' 'incremental'
LEADS ACCEPT

// END AUTOSET WORKPLANE

// STABLISH VARIABLES FOR STOCK MODEL VALUES 

REAL $VarTol = INPUT "Stock model tolerance(0.1 standard)?"
REAL $VarStp =  INPUT "Stock model stepover(2.0 standard )?"
REAL $VarRst =  INPUT  "Rest thickness(0.2 standard)?"


CREATE STOCKMODEL ; FORM STOCKMODEL
RENAME STOCKMODEL # "STOCK"
EDIT STOCKMODEL "STOCK" TOLERANCE $VarTol
EDIT STOCKMODEL "STOCK" STEPOVER $VarStp
EDIT STOCKMODEL "STOCK" RESTTHICKNESS $VarRst
EDIT STOCKMODEL "STOCK" REAPPLYFROMGUI
EDIT STOCKMODEL "STOCK" BLOCK ;
EDIT STOCKMODEL "STOCK" CALCULATE_STATE INDEXED_STATE 0
EXPLORER SELECT StockModel "StockModel\STOCK" NEW
EDIT STOCKMODEL "STOCK" SHADING DEFAULT


//   END  STABILISH  VARIABLES  FOR STOCK  MODEL


//



FORM STRATEGYSELECTOR
STRATEGYSELECTOR STRATEGY "C:/Users/dcard/AppData/Local/Autodesk/PowerMill/My-Strategies/01-FACE.ptf" NEW

STRATEGYSELECTOR STRATEGY "C:/Users/dcard/AppData/Local/Autodesk/PowerMill/My-Strategies/02-2D-PROFILE.ptf" NEW

STRATEGYSELECTOR STRATEGY "C:/Users/dcard/AppData/Local/Autodesk/PowerMill/My-Strategies/01-FACING.ptf" NEW

IMPORT TEMPLATE ENTITY TOOLPATH TMPLTSELECTORGUI "C:/Users/dcard/AppData/Local/Autodesk/PowerMill/My-Strategies/01-FACING.ptf"

EDIT TPPAGE SWBlock
EDIT BLOCK ZMIN UNLOCK
EDIT BLOCK ZMAX UNLOCK
EDIT BLOCK RESETLIMIT "0"
EDIT BLOCK RESET
EDIT BLOCK ZMAX "1"
EDIT TPPAGE SWFaceMilling
EDIT TOOLPATH "1" CALCULATE
FORM ACCEPT SFFaceMilling
FORM BLOCK
EDIT BLOCK ZMAX "0"
EDIT BLOCK RESET
BLOCK ACCEPT
EXPLORER SELECT FOLDER "Tool\Cutter" NEW
CREATE BOUNDARY ; BLOCK FORM BOUNDARY
EDIT BOUNDARY "1" PRIVATE NO
EDIT BOUNDARY "1" CALCULATE
EDIT BOUNDARY "1" ACCEPT BOUNDARY ACCEPT
FORM BLOCK
EDIT BLOCK ZMIN LOCK
EDIT BLOCK ZMAX LOCK
EDIT BLOCK RESETLIMIT "30"
EDIT BLOCK RESET
BLOCK ACCEPT
CREATE BOUNDARY ; BLOCK FORM BOUNDARY
EDIT BOUNDARY "2" PRIVATE NO
EDIT BOUNDARY "2" CALCULATE
EDIT BOUNDARY "2" ACCEPT BOUNDARY ACCEPT
CREATE BOUNDARY ; BOOLEANOPERATION FORM BOUNDARY
EDIT BOUNDARY "3" PRIVATE NO
EDIT BOUNDARY "3" REF_BOUNDARY_A "1"
EDIT BOUNDARY "3" REF_BOUNDARY_B "2"
EDIT BOUNDARY "3" CALCULATE
EDIT BOUNDARY "3" ACCEPT BOUNDARY ACCEPT
FORM STRATEGYSELECTOR
STRATEGYSELECTOR STRATEGY "C:/Users/dcard/AppData/Local/Autodesk/PowerMill/My-Strategies/02-2D-PROFILE.ptf" NEW

IMPORT TEMPLATE ENTITY TOOLPATH TMPLTSELECTORGUI "C:/Users/dcard/AppData/Local/Autodesk/PowerMill/My-Strategies/02-2D-PROFILE.ptf"

EDIT TPPAGE SWWorkplane
EDIT TPPAGE SWBlock
EDIT TPPAGE TOOL
EDIT TPPAGE SWLimit
ACTIVATE BOUNDARY "1"
EDIT TPPAGE SWStockEngage
EDIT TPPAGE SWConstZFinishing
EDIT TOOLPATH "2" CALCULATE
FORM ACCEPT SFConstZFinishing
EXPLORER SELECT Toolpath "Toolpath\2" NEW
RENAME Toolpath "2" "02-rgh-profle"
EXPLORER SELECT FOLDER "Tool\Facemill" NEW
EXPLORER SELECT Toolpath "Toolpath\02-rgh-profle" NEW
ACTIVATE TOOLPATH "02-rgh-profle" FORM TOOLPATH
EDIT TOOLPATH "02-rgh-profle" CLONE
RENAME TOOLPATH "02-rgh-profle_1" "03-semi-profle"
EDIT PAR 'Thickness' ".15"
EDIT PAR 'AxialDepthOfCut.UserDefined' '1' EDIT PAR 'Stepdown' "1"
EDIT TPPAGE TOOL
ACTIVATE TOOL "CUTTER D 25"
EDIT TPPAGE SWConstZFinishing
EDIT TOOLPATH "03-semi-profle" CALCULATE
EDIT TOOLPATH "03-semi-profle" CLONE
RENAME TOOLPATH "03-semi-profle_1" "04-Finish-Profile"
EDIT PAR 'Thickness' "0"
EDIT TOOLPATH "04-Finish-Profile" CALCULATE
EDIT TOOLPATH "04-Finish-Profile" CLONE
RENAME TOOLPATH "04-Finish-Profile_1" "05-adjust-0.03"
EDIT PAR 'Thickness' "-.015"
EDIT TOOLPATH "05-adjust-0.03" CALCULATE
EDIT TOOLPATH "05-adjust-0.03" CLONE
RENAME TOOLPATH "05-adjust-0.03_1" "06-adjust-0.06"
EDIT PAR 'Thickness' "-0.03"
EDIT TOOLPATH "06-adjust-0.06" CALCULATE
EDIT TOOLPATH "06-adjust-0.06" CLONE
RENAME TOOLPATH "06-adjust-0.06_1" "07-adjust-0.1"
EDIT PAR 'Thickness' "-0.05"
EDIT TOOLPATH "07-adjust-0.1" CALCULATE
EDIT TOOLPATH "07-adjust-0.1" CLONE
RENAME TOOLPATH "07-adjust-0.1_1" "08-adjust-0.15"
EDIT PAR 'Thickness' "-0.075"
EDIT TOOLPATH "08-adjust-0.15" CALCULATE
EDIT TOOLPATH "08-adjust-0.15" CLONE
RENAME TOOLPATH "08-adjust-0.15_1" "08-adjust-0.2"
EDIT PAR 'Thickness' "-0.1"
RENAME TOOLPATH "08-adjust-0.2" "09-adjust-0.2"
EDIT TOOLPATH "09-adjust-0.2" CALCULATE
EDIT TOOLPATH "09-adjust-0.2" CLONE
RENAME TOOLPATH "09-adjust-0.2_1" "10-adjust-0.25"
EDIT PAR 'Thickness' "-0.125"
EDIT TOOLPATH "10-adjust-0.25" CALCULATE
EDIT TOOLPATH "10-adjust-0.25" CLONE
RENAME TOOLPATH "10-adjust-0.25_1" "11-adjust-0.3"
EDIT PAR 'Thickness' "-0.15"
EDIT TOOLPATH "11-adjust-0.3" CALCULATE
FORM ACCEPT SFConstZFinishing
EXPLORER SELECT Toolpath "Toolpath\1" NEW
RENAME Toolpath "1" "01-Facing"
EXPLORER SELECT FOLDER "Tool\Ballnose" NEW
CREATE FOLDER "Toolpath" ; 
EXPLORER SELECT FOLDER "Toolpath\Folder1" NEW
RENAME FOLDER "Toolpath\Folder1" "Face-Square"
EXPLORER SELECT FOLDER "Tool\Facemill" NEW
EXPLORER SELECT Toolpath "Toolpath\01-Facing" NEW
EXPLORER SELECT Toolpath "Toolpath\11-adjust-0.3" SERIES
EDIT FOLDER "Toolpath\Face-Square" INSERT "Toolpath\01-Facing" LAST
EDIT FOLDER "Toolpath\Face-Square" INSERT "Toolpath\02-rgh-profle" LAST
EDIT FOLDER "Toolpath\Face-Square" INSERT "Toolpath\03-semi-profle" LAST
