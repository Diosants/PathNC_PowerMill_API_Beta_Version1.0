//   ROUGHN MACRO  CAVITY MOLD TOOL DIAM 40 R1.5
// WORKING 100 %

//  SETTING VARIABLES//

CREATE BOUNDARY ; BLOCK FORM BOUNDARY
EDIT BOUNDARY "1" CALCULATE
EDIT BOUNDARY "1" ACCEPT BOUNDARY ACCEPT
IMPORT TEMPLATE ENTITY TOOLPATH TMPLTSELECTORGUI "C:/Users/dcard/AppData/Local/Autodesk/PowerMill/My-Strategies/Rough.ptf"
RENAME TOOLPATH "1" "Rough_Dia50r5"
EDIT TPPAGE TOOL
ACTIVATE TOOL "CUTTER D 40"
RENAME TOOLPATH "Rough_Dia50r5" "Rough_Dia40"
EDIT TOOL "CUTTER D 40" NUMBER COMMANDFROMUI 1
EDIT TPPAGE SWMachineTool
EDIT TPPAGE TOOL
EXPLORER SELECT FOLDER "Tool\Facemill" NEW
EDIT TOOL "CUTTER D 40" NUMBER COMMANDFROMUI 10
EDIT TOOL "CUTTER D 40" NUM_FLUTES "2"
EDIT TPPAGE SWOffsetAreaClear
EDIT TPPAGE SWMachineTool
EDIT TPPAGE SWLimit
ACTIVATE BOUNDARY "1"
EDIT PAR 'ZRange.Minimum.Active' 0
EDIT TPPAGE SWAreaClearance
EDIT PAR 'Thickness' "0.2"
EDIT PAR 'RadialDepthOfCut.UserDefined' '1' EDIT PAR 'Stepover' "28"
EDIT ZHEIGHTS AUTOMATIC STEPDOWN ".75"
EDIT TPPAGE SWOffsetAreaClear
EDIT TPPAGE SWStepReduction
EDIT TPPAGE SWFinishAreaClr
EDIT TPPAGE SWAreaFilterAClear
EDIT TPPAGE SWAreaFlatAClear
EDIT TPPAGE SWHighSpeedAClr
EDIT TPPAGE SWAreaFlatAClear
EDIT PAR 'AreaClearance.Slicer.Flat.HoleFilterThreshold.Active' '1'
EDIT TPPAGE SWHighSpeedAClr
EDIT TPPAGE SWOrderBasic
EDIT TPPAGE SWAutoVerifMdlG
EDIT TPPAGE SWToolRapidMvClear
EDIT TPPAGE SWSEPtSPoint
EDIT TOOLPATH START TYPE POINT_SAFE
EDIT TPPAGE SWFeedSpeed
EDIT TPPAGE SWLeadFeedRate
EDIT TPPAGE SWSEPtEPoint
EDIT TPPAGE SWFeedSpeed
EDIT RPM "1600"
EDIT FRATE "4000"
EDIT PRATE "4000"
EDIT RSPEED "6000"
EDIT TPPAGE SWLeadIn
EDIT TPPAGE SWLeadOut
EDIT TPPAGE SWLink
EDIT PAR 'Toolpath.Connections.Link.First.Constraint[0].Distance.Value' "50"
EDIT PAR 'Connections.Link[0].Type' 'skim'
EDIT PAR 'Connections.Link[0].ApplyConstraints' '0'
EDIT PAR 'Connections.DefaultLink[0].Type' 'incremental'
EDIT TOOLPATH "Rough_Dia40" CALCULATE
FORM ACCEPT SFAreaClearance
EXPLORER SELECT Toolpath "Toolpath\Rough_Dia40" NEW
FORM COLLISION
EDIT COLLISION SPLIT_TOOLPATH N
EDIT COLLISION HOLDER_CLEARANCE "1"
EDIT COLLISION SHANK_CLEARANCE "1"
EDIT COLLISION APPLY
COLLISION ACCEPT
EDIT STOCKMODEL ; INSERT_INPUT TOOLPATH "Rough_Dia40" LAST
EXPLORER SELECT StockModel "StockModel\STOCK" NEW
EDIT STOCKMODEL "STOCK" CALCULATE_STATE INDEXED_STATE 1
EXPLORER SELECT StockModel "StockModel\STOCK" NEW
EXPLORER SELECT StockModel "StockModel\STOCK" NEW
DRAW StockModel "STOCK"
EXPLORER SELECT Toolpath "Toolpath\Rough_Dia40" NEW
DRAW Toolpath "Rough_Dia40"
EXPLORER SELECT Toolpath "Toolpath\Rough_Dia40" NEW
UNDRAW Toolpath "Rough_Dia40"
ROTATE TRANSFORM ISO1
