// =============================================================
// PowerMill Automation by DiogenixCAM
// Project: Feature Machining Automation
// Description: Create circular feature + run selected strategy
// Author: Diogenes Cardoso Ferreira
// =============================================================

RESET LOCALVARS

// ==============================
// STEP 1: Create Feature
// ==============================
REAL $VarDiameter = INPUT "Enter Diameter (mm)"
REAL $VarHeight   = INPUT "Enter Height (mm)"

CREATE FEATUREGROUP
EXPLORER SELECT FeatureGroup "#" NEW
ACTIVATE FEATUREGROUP "#" MODE FEATUREEDITOR START

MODE FEATUREEDITOR MODE CREATE CIRC_POCKET
MODE FEATUREEDITOR EDIT NAME "#"
MODE FEATUREEDITOR EDIT DIAMETER $VarDiameter
MODE FEATUREEDITOR EDIT HEIGHT $VarHeight
MODE FEATUREEDITOR EDIT CURVEPOSITION TOP

MODE POSITION START
MODE POSITION WORKSPACE WORKPLANE
MODE POSITION PLANE XY
MODE POSITION CARTESIAN X "0"
MODE POSITION CARTESIAN Y "0"
POSITION APPLY
FORM APPLY FEEDIT
FORM CANCEL FEEDIT
MODE FEATUREEDITOR FINISH ACCEPT

STRING $FtName = "CircPocket_Diam_" + string($VarDiameter)
RENAME FEATUREGROUP "#" $FtName

// ==============================
// STEP 2: Create Block From Feature
// ==============================
FORM BLOCK
EDIT BLOCKTYPE CYLINDER
EDIT BLOCK LIMITTYPE FEATURESET
EDIT BLOCK RESETLIMIT "0"
EDIT BLOCK RESET
BLOCK ACCEPT
ROTATE TRANSFORM TOP

// ==============================
// STEP 3: User Input for Strategy
// ==============================
STRING LIST $FeatureOptions = {
  "Feature Area Clearance",
  "Pocket Area Clearance",
  "Finish Feature",
  "Pocket Profile",
  "Finish Profile"
}

INT $FeatureOptionSelected = INPUT CHOICE $FeatureOptions "Select Feature Strategy:"
STRING $VarSelectedTool = INPUT ENTITY TOOL "Select a tool from the list:"
REAL $VarToolDepth = INPUT "Enter Z Stepdown (positive value)"
REAL $VarStock = INPUT "Enter Stock to leave (mm)"

// ==============================
// STEP 4: Switch Strategies
// ==============================
SWITCH $FeatureOptionSelected
{

// ------------------------------------------------------------
// CASE 0: Feature Area Clearance
// ------------------------------------------------------------
CASE 0
    CALL RunStrategy("Feature-Machining/Feature-Area-Clearance.ptf", $FtName, $VarSelectedTool, $VarStock, $VarToolDepth)
    MESSAGE INFO "Feature Area Clearance calculated successfully"
    BREAK

// ------------------------------------------------------------
// CASE 1: Pocket Area Clearance
// ------------------------------------------------------------
CASE 1
    CALL RunStrategy("Feature-Machining/Feature-Pocket-Area-Clearance.ptf", $FtName, $VarSelectedTool, $VarStock, $VarToolDepth)
    MESSAGE INFO "Pocket Area Clearance calculated successfully"
    BREAK

// ------------------------------------------------------------
// CASE 2: Finish Feature
// ------------------------------------------------------------
CASE 2
    CALL RunStrategy("Feature-Machining/Feature-Finishing.ptf", $FtName, $VarSelectedTool, $VarStock, $VarToolDepth)
    MESSAGE INFO "Feature Finishing calculated successfully"
    BREAK

// ------------------------------------------------------------
// CASE 3: Pocket Profile
// ------------------------------------------------------------
CASE 3
    CALL RunStrategy("Feature-Machining/Feature-Pocket-Profile.ptf", $FtName, $VarSelectedTool, $VarStock, $VarToolDepth)
    MESSAGE INFO "Pocket Profile calculated successfully"
    BREAK

// ------------------------------------------------------------
// CASE 4: Finish Profile
// ------------------------------------------------------------
CASE 4
    CALL RunStrategy("Feature-Machining/Feature-Profile.ptf", $FtName, $VarSelectedTool, $VarStock, $VarToolDepth)
    MESSAGE INFO "Finish Profile calculated successfully"
    BREAK

DEFAULT
    MESSAGE WARN "Invalid selection."
}

// ==============================
// FUNCTION: RunStrategy
// ==============================
FUNCTION RunStrategy(STRING $Template, STRING $FeatureName, ENTITY $Tool, REAL $Stock, REAL $Stepdown)
{
    FORM STRATEGYSELECTOR
    STRATEGYSELECTOR STRATEGY $Template NEW
    IMPORT TEMPLATE ENTITY TOOLPATH TMPLTSELECTORGUI $Template

    ACTIVATE FEATUREGROUP $FeatureName
    EDIT TPPAGE TOOL
    ACTIVATE TOOL $Tool

    // Apply common parameters
    EDIT PAR 'CutDirection' 'any'
    EDIT PAR 'Thickness' $Stock
    EDIT ZHEIGHTS AUTOMATIC STEPDOWN $Stepdown
    EDIT PAR 'CollisionCheck' '1'
    EDIT PAR 'ModelGougeCheck' '1'

    // Calculate toolpath
    EDIT TOOLPATH "1" CALCULATE
    FORM ACCEPT SFAreaClearance

    STRING $TName = string(Tool.Name) + "_" + get_typename(Toolpath.Strategy)
    RENAME TOOLPATH ; $TName
    PRINT = "Toolpath Created: " + $TName
}
