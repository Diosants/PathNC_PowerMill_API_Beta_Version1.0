EXPLORER SELECT Model "#" NEW
EDIT MODEL "#" SELECT SURFACE
CREATE BOUNDARY ; BLOCK FORM BOUNDARY
EDIT BOUNDARY "#" PRIVATE NO
EDIT BOUNDARY "#" AUTOREPLAY NO
EDIT BOUNDARY "#" CALCULATE
EDIT BOUNDARY "#" ACCEPT BOUNDARY ACCEPT
FORM STRATEGYSELECTOR
IMPORT TEMPLATE ENTITY TOOLPATH TMPLTSELECTORGUI "Finishing/Constant-Z-Finishing.002.ptf"


//  DECLARING VARIABLES

//REAL $BlockExpansion = INPUT "  BLOCK EXPANSION"
//REAL $Thickness =      INPUT "  THICKNESS"
//REAL $Tolerance =  INPUT "  TOLERANCE"
//REAL $StepDown = IMPUT " STEPDOWN"

RENAME TOOLPATH "#" "Contour_Rough"
EDIT TPPAGE SWBlock
EDIT BLOCK ZMIN LOCK
EDIT BLOCK ZMAX LOCK
EDIT BLOCK RESETLIMIT "17"
EDIT BLOCK RESET
EDIT TPPAGE TOOL
ACTIVATE TOOL "CUTTER D 32"
EDIT TPPAGE SWLimit
EDIT PAR 'BoundaryLimit.Keep' 'outside'
EDIT TPPAGE SWStockEngage
EDIT TPPAGE SWConstZFinishing
EDIT PAR 'Thickness' ".5"
EDIT PAR 'Tolerance' ".05"
EDIT PAR 'AxialDepthOfCut.UserDefined' '1' EDIT PAR 'Stepdown' ".5"
EDIT TPPAGE SWHighSpeed
EDIT TPPAGE SWAreaFilter
EDIT PAR 'UnsafeSegmentRemoval.Active' '1'
EDIT TPPAGE SWAutoVerifBasic
EDIT PAR 'CollisionCheck' '1'
EDIT TPPAGE SWPointDistrb
EDIT TPPAGE SWToolAxis
EDIT TPPAGE SWToolAxOVec
EDIT TPPAGE SWToolRapidMv
EDIT TOOLPATH SAFEAREA SIZE  "10"
EDIT TOOLPATH SAFEAREA PLUNGE_SIZE  "5"
EDIT TPPAGE SWToolRapidMvClear
EDIT TPPAGE SWLeadsLinks
EDIT TPPAGE SWLeadIn
EDIT TOOLPATH LEADS LEADIN HARC
EDIT TOOLPATH LEADS LEADIN ANGLE "60"
EDIT TOOLPATH LEADS LEADIN LRAD "10"
EDIT TOOLPATH LEADS LEADOUT COPY
EDIT TPPAGE SWLeadOut
EDIT TPPAGE SWFirstLastLeads
EDIT TPPAGE SWLeadExtensions
EDIT TPPAGE SWLink
EDIT PAR 'Connections.Link[0].Type' 'circular_arc'
EDIT PAR 'Connections.Link.First.Constraint[0].Distance.Value' "50"
EDIT PAR 'Connections.Link[1].Type' 'skim'
EDIT PAR 'Connections.DefaultLink[0].Type' 'skim'
EDIT TPPAGE SWFeedSpeed
EDIT RPM "2500"
EDIT FRATE "3200"
EDIT PRATE "3200"
EDIT RSPEED "8000"
EDIT COOLANT AIR
EDIT TPPAGE SWLeadFeedRate
EDIT TOOLPATH "Contour_Rough" CALCULATE
FORM ACCEPT SFConstZFinishing
EXPLORER SELECT FOLDER "Tool\Cutter" NEW
EXPLORER SELECT Tool "Tool\Cutter\CUTTER D 32" NEW
DEACTIVATE TOOL
EXPLORER SELECT Toolpath "Toolpath\Constant_Z_Finishing" NEW


///   SEMI CONTOUR


FORM STRATEGYSELECTOR
STRATEGYSELECTOR STRATEGY "Finishing/Constant-Z-Finishing.002.ptf" NEW

IMPORT TEMPLATE ENTITY TOOLPATH TMPLTSELECTORGUI "Finishing/Constant-Z-Finishing.002.ptf"


RENAME TOOLPATH "#" "Contour_Semi"
EDIT TPPAGE SWBlock
EDIT BLOCK RESETLIMIT "17"
EDIT BLOCK RESET
EDIT TPPAGE TOOL
ACTIVATE TOOL "ENDMILLR D14"
EDIT TPPAGE SWConstZFinishing
EDIT TPPAGE SWLimit
EDIT PAR 'BoundaryLimit.Keep' 'outside'
EDIT TPPAGE SWConstZFinishing
EDIT PAR 'Thickness' ".15"
EDIT PAR 'Tolerance' ".05"
EDIT PAR 'AxialDepthOfCut.UserDefined' '1' EDIT PAR 'Stepdown' "1.0"
EDIT TPPAGE SWHighSpeed
EDIT TPPAGE SWAreaFilter
EDIT TPPAGE SWAutoVerifBasic
EDIT TPPAGE SWPointDistrb
EDIT TPPAGE SWToolRapidMv
EDIT TOOLPATH "Contour_Semi" CALCULATE
FORM ACCEPT SFConstZFinishing


// Finish Contourn

FORM STRATEGYSELECTOR
STRATEGYSELECTOR STRATEGY "Finishing/Constant-Z-Finishing.002.ptf" NEW

IMPORT TEMPLATE ENTITY TOOLPATH TMPLTSELECTORGUI "Finishing/Constant-Z-Finishing.002.ptf"


RENAME TOOLPATH "#" "Contour_Finish"
EDIT TPPAGE SWBlock
EDIT BLOCK RESETLIMIT "17"
EDIT BLOCK RESET
EDIT TPPAGE TOOL
ACTIVATE TOOL "ENDMILLR D14"
EDIT TPPAGE SWConstZFinishing
EDIT TPPAGE SWLimit
EDIT PAR 'BoundaryLimit.Keep' 'outside'
EDIT TPPAGE SWConstZFinishing
EDIT PAR 'Thickness' "0.0"
EDIT PAR 'AxialDepthOfCut.UserDefined' '1' EDIT PAR 'Stepdown' "2.0"
EDIT TPPAGE SWHighSpeed
EDIT TPPAGE SWAreaFilter
EDIT TPPAGE SWAutoVerifBasic
EDIT TPPAGE SWPointDistrb
EDIT TPPAGE SWToolRapidMv
RENAME TOOLPATH "#" "Contour_Finish"
EDIT TOOLPATH "Contour_Finish" CALCULATE
FORM ACCEPT SFConstZFinishing







