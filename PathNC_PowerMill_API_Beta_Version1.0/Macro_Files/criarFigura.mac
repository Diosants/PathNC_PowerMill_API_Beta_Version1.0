ROTATE TRANSFORM TOP
CREATE FEATUREGROUP ;

REAL $VarLength = INPUT "INPUT LENGHT SIZE"
REAL $VarWidth =  INPUT "INPUT WIDTH SIZE"
REAL $VarHeight =  INPUT  "INPUT  HEIGHT SIZE"
REAL $VarCorners = INPUT "INPUT CORNER RADIUS"
REAL $VarFillet = INPUT "INPUT WIDTH FILLET"


EXPLORER SELECT FeatureGroup "FeatureGroup\1" NEW
ACTIVATE FEATUREGROUP "1" MODE FEATUREEDITOR START
MODE FEATUREEDITOR MODE CREATE RECT_BOSS
MODE FEATUREEDITOR EDIT LENGTH $VarLength
MODE FEATUREEDITOR EDIT WIDTH $VarWidth
MODE FEATUREEDITOR EDIT HEIGHT $VarHeight
MODE FEATUREEDITOR TAB CORNERS
MODE FEATUREEDITOR EDIT EXTERNALCORNERRADIUS "10"
MODE FEATUREEDITOR TAB FILLETS
MODE FEATUREEDITOR EDIT TOPTYPE CHAMFER
MODE FEATUREEDITOR EDIT CHAMFER TOP WIDTH $VarFillet
MODE FEATUREEDITOR EDIT NAME "Boss1"
PICK -426.25 -316.582 426.25 316.582 -50.2539 -7.65276 -18 0 0 1 0 1 0 0 -248.116 176.014 -248.116 176.014
MODE FEATUREEDITOR EDIT CREATION SINGLE
PICK -185.213 -137.561 185.213 137.561 69.0406 -0.814751 -18 0 0 1 0 1 0 0 -69.636 1.71128 -69.636 1.71128
MODE FEATUREEDITOR EDIT WORKSPACE WORLD
MODE FEATUREEDITOR EDIT WORKSPACE FEATUREGROUP
MODE FEATUREEDITOR EDIT WORKSPACE WORLD
MODE FEATUREEDITOR EDIT WORKSPACE FEATUREGROUP
MODE FEATUREEDITOR EDIT CURVEPOSITION TOP
FORM APPLY FEEDIT
FORM CANCEL FEEDIT
MODE FEATUREEDITOR FINISH ACCEPT

FORM RIBBON TAB "Simulation"




///  Create  Pocket

//  Declaring Variables//

REAL $VarPocketLenght = INPUT "Plese,type Pocket Lenght"
REAL $VarPocketWidth =  INPUT "Plese,type Pocket Width "
REAL $VarPocketHeight =  INPUT  "Please, Type Pocket Height?"
REAL $VarCornerRadius = INPUT "Please,Type Corner Radius"
REAL $VarChamferWidth = INPUT "Please, Type Chamfer Width"



CREATE FEATUREGROUP ;
EXPLORER SELECT FeatureGroup "FeatureGroup\1" NEW
ACTIVATE FEATUREGROUP "1" MODE FEATUREEDITOR START
MODE FEATUREEDITOR MODE CREATE RECT_POCKET
ROTATE TRANSFORM TOP
MODE FEATUREEDITOR EDIT LENGTH $VarPocketLenght
MODE FEATUREEDITOR EDIT WIDTH $VarPocketWidth
MODE FEATUREEDITOR EDIT HEIGHT $VarPocketHeight
MODE FEATUREEDITOR EDIT CURVEPOSITION TOP
MODE FEATUREEDITOR TAB CORNERS
MODE FEATUREEDITOR EDIT CORNERRADIUS $VarCornerRadius
MODE FEATUREEDITOR TAB FILLETS
MODE FEATUREEDITOR EDIT TOPTYPE CHAMFER
MODE FEATUREEDITOR EDIT CHAMFER TOP WIDTH $VarChamferWidth
MODE FEATUREEDITOR TAB ORIGIN
MODE FEATUREEDITOR TAB DIMENSIONS
PICK -185.213 -137.561 185.213 137.561 69.0406 -0.814751 -18 0 0 1 0 1 0 0 -69.636 1.71128 -69.636 1.71128
MODE FEATUREEDITOR EDIT CURVEPOSITION BOTTOM
FORM APPLY FEEDIT
FORM CANCEL FEEDIT
MODE FEATUREEDITOR FINISH ACCEPT




