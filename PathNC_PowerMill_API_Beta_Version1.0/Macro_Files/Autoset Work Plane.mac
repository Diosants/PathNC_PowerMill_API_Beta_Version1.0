
//    MACRO AUTOSET   WORKPLANE

//  DECLARING VARIABLES//

REAL $VarSafearea = INPUT " Input safe area size"
REAL $VarPlunge = INPUT " Input plunge size"


WAIT FORM

PICK -491.932 -439.286 491.932 439.286 -28.9639 170.984 31.8204 0 0 1 0 1 0 0 -212.977 -245.795 -212.977 -245.795
EDIT MODEL ALL SELECT SURFACE
MODE WORKPLANE_CREATE ; SELECTION TOP
EXPLORER SELECT Workplane "Workplane\1" NEW
ACTIVATE WORKPLANE "1"
EXPLORER SELECT Model "Model\Boss" NEW
TRANSFORM RESET TRANSFORM TYPE WORLD TRANSFORM MODEL ALL SELECTED
EXPLORER SELECT Workplane "Workplane\1" NEW
DEACTIVATE WORKPLANE
DELETE Workplane "1"
FORM BLOCK
EDIT BLOCK COORDINATE WORLD
EDIT BLOCK RESET
BLOCK ACCEPT
EDIT TOOLPATH LEADS RAISEFORM
EDIT TOOLPATH SAFEAREA SIZE  $VarSafearea
EDIT TOOLPATH SAFEAREA PLUNGE_SIZE  $VarPlunge
EDIT TOOLPATH SAFEAREA DRAWABLE RAPID ON
EDIT TOOLPATH SAFEAREA DRAWABLE PLUNGE ON
EDIT TOOLPATH LEADS PAGE LINK
EDIT PAR 'Connections.Link[0].Type' 'skim'
EDIT PAR 'Connections.Link[1].Type' 'skim'
EDIT PAR 'Connections.DefaultLink[0].Type' 'incremental'
LEADS ACCEPT
